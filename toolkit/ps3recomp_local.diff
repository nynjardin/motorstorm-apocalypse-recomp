+static int zq_slot(u32 off)           /* -1 when another offset has the slot */
+{
+    /* (off >> 4) keeps consecutive reports in consecutive slots (they resolve as one run); a
+     * second report area whose offsets fold onto the first gets the other half of the table. */
+    u32 sl = (off >> 4) & (ZQ_MAX - 1u);
+    for (int pr = 0; pr < 2; pr++, sl = (sl + ZQ_MAX / 2u) & (ZQ_MAX - 1u)) {
+        if (s_zq_off[sl] == off + 1u) return (int)sl;
+        if (!s_zq_off[sl]) { s_zq_off[sl] = off + 1u; return (int)sl; }
+    }
+    return -1;
