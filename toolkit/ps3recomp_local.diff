+/* COND_RENDER=1 (patch #52, off by default): GPU occlusion culling as the title programs it.
+ * MotorStorm: Apocalypse counts the depth-passing pixels of ~1700 objects a frame
+ * (CLEAR_REPORT_VALUE, draws with ZPASS_PIXEL_COUNT_ENABLE, GET_REPORT into main memory) and
+ * draws each one for real under SET_RENDER_ENABLE(conditional, that report): the RSX skips it
+ * when the count is zero. No CPU reads those reports, so the fixed "visible" value changed
+ * nothing: every object was drawn, light halos behind walls included. Here each accumulation
+ * is a D3D12 occlusion query, resolved on the GPU into a buffer, and a conditional draw is
+ * issued under SetPredication on its slot. Nothing is read back.
+ *  - FIFO side (rsx_d3d12_zpass_event, called by cellGcmSys.c in command order): a report
+ *    offset gets a slot; GET_REPORT names the slot of the draws recorded since the last CLEAR;
+ *    SET_RENDER_ENABLE makes the next draws conditional on a slot, only if that slot holds a
+ *    query of ours (else they are drawn as before).
+ *  - render side: BeginQuery at the first draw of an accumulation, EndQuery after its last;
+ *    before a conditional draw whose query is not resolved yet, all ended queries are resolved.
+ * Conservative wherever the picture is not the simple one: a report without a CLEAR before it,
+ * an accumulation with no draw, a slot collision -> "visible". The result buffer starts as
+ * "visible". COND_RENDER_STATS=<frames>: counts per frame. */
+#define ZQ_MAX 8192u
+static int  s_zq_enable;              /* ZPASS_PIXEL_COUNT_ENABLE */
+static u32  s_zq_first;               /* record count at the last CLEAR_REPORT_VALUE */
+static u32  s_zq_seq = 1;             /* current accumulation (never 0) */
+static int  s_zq_cleared = 1;         /* a CLEAR_REPORT_VALUE came since the last GET_REPORT */
+static int  s_zq_pred = -1;           /* slot the draws being recorded are conditional on */
+static u32  s_zq_off[ZQ_MAX];         /* report offset + 1 held by a slot */
+static u8   s_zq_state[ZQ_MAX];       /* 1 = the slot holds a query of ours, 2 = unknown: visible */
+static int zq_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("COND_RENDER"); v = e ? atoi(e) : 0; }
+    return v;
