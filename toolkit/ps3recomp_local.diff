+static inline u64 vrs_mix(u64 h, u64 w) { h = (h ^ w) * 0x9E3779B97F4A7C15ull; return h ^ (h >> 29); }
+static u64 vrs_bytes(u64 h, const u8* p, u64 n)
+{
+    u64 k = 0;
+    for (; k + 8 <= n; k += 8) { u64 w; memcpy(&w, p + k, 8); h = vrs_mix(h, w); }
+    if (k < n) { u64 w = 0; memcpy(&w, p + k, (size_t)(n - k)); h = vrs_mix(h, w); }
+    return h;
+}
