+    if (m == 0x17CCu) { s_zq_enable = v != 0; s_zq_dbg[0]++; return; }
+    if (m == 0x17C8u) { if (!++s_zq_seq) s_zq_seq = 1; s_zq_cleared = 1; s_zq_first = s_d3d.draw_count; s_zq_dbg[1]++; return; }
+    if (m == 0x1E98u) { s_zq_dbg[2]++;
+        const int sl = ((v >> 24) == 2u) ? zq_slot(v & 0xFFFFFFu) : -1;
+        s_zq_pred = (sl >= 0 && s_zq_state[sl] == 1) ? sl : -1;
+        return;
+    }
+    if (m == 0x1800u) {
+        const int sl = zq_slot(v & 0xFFFFFFu);
+        int n = 0;
+        s_zq_dbg[3]++; if (sl < 0) s_zq_dbg[6]++; if (!s_zq_cleared) s_zq_dbg[7]++;
+        if (sl >= 0 && s_zq_cleared) {
+            int last = 1;
+            /* only the records made since the CLEAR (the whole frame's when the record list was
+             * reset in between): without that bound an accumulation with no draw walked 4096
+             * records back, 1700 times a frame */
+            const int lo = (s_zq_first <= s_d3d.draw_count) ? (int)s_zq_first : 0;
+            for (int d = (int)s_d3d.draw_count - 1, back = 0; d >= lo && back < 4096; d--, back++) {
+                D3D12DrawRecord* r = &s_d3d.draws[d];
+                if (!r->is_vp || r->is_clear) continue;    /* clears and copies carry no query fields (records are reused) */
+                if (r->q_seq == s_zq_seq) { r->q_idx = sl; r->q_last = last; last = 0; n++; }
+                else if (r->q_seq != 0) break;
+            }
+        }
+        if (n) s_zq_dbg[4]++;
+        if (sl >= 0) s_zq_state[sl] = n ? 1 : 2;
+        s_zq_cleared = 0;
+        if (!++s_zq_seq) s_zq_seq = 1;     /* draws after this report are not part of it */
+    }
+}
+static void rec_query(D3D12DrawRecord* dr)
+{
+    dr->q_seq = (zq_on() > 0 && s_zq_enable) ? s_zq_seq : 0;
+    if (dr->q_seq) s_zq_dbg[5]++;
+    dr->q_idx = -1; dr->q_last = 0;
+    dr->pred_idx = zq_on() > 0 ? s_zq_pred : -1;
+}
+/* render side */
+static ID3D12QueryHeap* s_zq_heap;
+static ID3D12Resource*  s_zq_buf;     /* ZQ_MAX u64 sample counts, in the PREDICATION state between uses */
+static ID3D12Resource*  s_zq_init;    /* upload: the "visible" start value */
+static int  s_zq_ready;               /* 0 = not tried, 1 = usable, -1 = failed */
+static int  s_zq_open = -1; static u32 s_zq_open_seq; static int s_zq_end_next;
+static u16  s_zq_pend[ZQ_MAX]; static u32 s_zq_npend; static u8 s_zq_ispend[ZQ_MAX];
+static u32  s_zq_st_q, s_zq_st_pred, s_zq_st_res, s_zq_st_runs, s_zq_st_frames;
+static void zq_buf_state(D3D12_RESOURCE_STATES from, D3D12_RESOURCE_STATES to)
+{
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = s_zq_buf;
+    b.Transition.StateBefore = from; b.Transition.StateAfter = to;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+}
+static int zq_init(void)              /* with the command list open */
+{
+    if (s_zq_ready) return s_zq_ready > 0;
+    s_zq_ready = -1;
+    D3D12_QUERY_HEAP_DESC qd = {0};
+    qd.Type = D3D12_QUERY_HEAP_TYPE_OCCLUSION; qd.Count = ZQ_MAX;
+    if (FAILED(s_d3d.device->lpVtbl->CreateQueryHeap(s_d3d.device, &qd, &IID_ID3D12QueryHeap, (void**)&s_zq_heap))) return 0;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = (u64)ZQ_MAX * 8u; bd.Height = 1;
+    bd.DepthOrArraySize = 1; bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_zq_buf))) return 0;
+    hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&s_zq_init))) return 0;
+    { void* mp = NULL; D3D12_RANGE nr = {0, 0};
+      if (FAILED(s_zq_init->lpVtbl->Map(s_zq_init, 0, &nr, &mp)) || !mp) return 0;
+      memset(mp, 1, (size_t)ZQ_MAX * 8u);
+      s_zq_init->lpVtbl->Unmap(s_zq_init, 0, NULL); }
+    s_d3d.cmd_list->lpVtbl->CopyBufferRegion(s_d3d.cmd_list, s_zq_buf, 0, s_zq_init, 0, (u64)ZQ_MAX * 8u);
+    zq_buf_state(D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PREDICATION);
+    fprintf(stderr, "[COND_RENDER] occlusion queries + predication on (%u slots)%c", ZQ_MAX, 10);
+    s_zq_ready = 1;
+    return 1;
+}
+static void zq_end_open(void)
+{
+    if (s_zq_open < 0) return;
+    s_d3d.cmd_list->lpVtbl->EndQuery(s_d3d.cmd_list, s_zq_heap, D3D12_QUERY_TYPE_OCCLUSION, (UINT)s_zq_open);
+    if (!s_zq_ispend[s_zq_open]) { s_zq_ispend[s_zq_open] = 1; s_zq_pend[s_zq_npend++] = (u16)s_zq_open; }
+    s_zq_open = -1; s_zq_end_next = 0;
+}
+static void zq_resolve(void)
+{
+    if (!s_zq_npend) return;
+    zq_buf_state(D3D12_RESOURCE_STATE_PREDICATION, D3D12_RESOURCE_STATE_COPY_DEST);
+    /* runs of consecutive slots, found through the flags rather than by sorting the list */
+    for (u32 i = 0; i < s_zq_npend; i++) {
+        u32 a = s_zq_pend[i];
+        if (!s_zq_ispend[a]) continue;                 /* taken by an earlier run */
+        while (a > 0 && s_zq_ispend[a - 1]) a--;
+        u32 e = a;
+        while (e < ZQ_MAX && s_zq_ispend[e]) { s_zq_ispend[e] = 0; e++; }
+        s_d3d.cmd_list->lpVtbl->ResolveQueryData(s_d3d.cmd_list, s_zq_heap, D3D12_QUERY_TYPE_OCCLUSION,
+                                                 a, e - a, s_zq_buf, (u64)a * 8u);
+        s_zq_st_runs++;
+    }
+    s_zq_npend = 0;
+    zq_buf_state(D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PREDICATION);
+    s_zq_st_res++;
+}
+/* At the top of the record loop, for every record. */
+static void zq_record_top(const D3D12DrawRecord* dr)
+{
+    if (dr->is_clear) return;         /* no query fields on these records; an open query stays open */
+    if (s_zq_open >= 0 && (s_zq_end_next || (dr->q_seq != 0 && dr->q_seq != s_zq_open_seq))) zq_end_open();
+    if (dr->q_seq != 0 && dr->q_idx >= 0 && !dr->is_clear && s_zq_open < 0 && zq_init()) {
+        s_d3d.cmd_list->lpVtbl->BeginQuery(s_d3d.cmd_list, s_zq_heap, D3D12_QUERY_TYPE_OCCLUSION, (UINT)dr->q_idx);
+        s_zq_open = dr->q_idx; s_zq_open_seq = dr->q_seq; s_zq_st_q++;
+    }
+    if (s_zq_open >= 0 && dr->q_last && dr->q_seq == s_zq_open_seq) s_zq_end_next = 1;
+}
+/* Around the draw call of a record: 1 = predication was set (clear it after the draw). */
+static int zq_pred_begin(const D3D12DrawRecord* dr)
+{
+    const int p = dr->is_clear ? -1 : dr->pred_idx;
+    if (p < 0 || p >= (int)ZQ_MAX || s_zq_ready <= 0) return 0;
+    if (s_zq_open == p) zq_end_open();
+    if (s_zq_ispend[p]) zq_resolve();
+    s_d3d.cmd_list->lpVtbl->SetPredication(s_d3d.cmd_list, s_zq_buf, (u64)p * 8u, D3D12_PREDICATION_OP_EQUAL_ZERO);
+    s_zq_st_pred++;
+    return 1;
+}
+/* PIX_COUNT_FILE=<file> (diagnostic; the file holds "<unit> [<min> [<max> vertices]]", or -1):
+ * once a second, the samples each draw that samples its own colour target on that unit
+ * (the FB_KILL_UNIT_FILE family) writes, by an occlusion query around it, printed a few frames
+ * later as [PIXCOUNT] lines. Independent of the camera: a draw that covers a car-sized patch of
+ * road writes thousands of samples, a lamp a few dozen. Not with COND_RENDER=1 (one occlusion
+ * query at a time). */
+/* Unit 16 = every draw, whatever it samples. A 4th field (hex) = a fragment program whose draws
+ * are left out (FP_KILL while the game runs: the program addresses change with every run). */
+#define PC_MAX 2048
+static ID3D12QueryHeap* s_pc_heap; static ID3D12Resource* s_pc_rb;
+static int s_pc_ready, s_pc_n, s_pc_active, s_pc_unit = -1, s_pc_min = 0, s_pc_max = 64, s_pc_pending, s_pc_rounds;
+static u64 s_pc_frame, s_pc_next, s_pc_fread;
+static struct { u32 fp, nv, ic, d, rt; } s_pc_info[PC_MAX];
+static int pc_frame_begin(void)       /* before the record loop: measure this frame? */
+{
+    static const char* f = (const char*)-1;
+    if (f == (const char*)-1) f = getenv("PIX_COUNT_FILE");
+    s_pc_active = 0; s_pc_n = 0;
+    if (!f) return 0;
+    if (s_d3d.frame_count >= s_pc_fread + 15) {
+        s_pc_fread = s_d3d.frame_count; s_pc_unit = -1; s_pc_min = 0; s_pc_max = 64;
+        const u32 was = s_pc_kill; s_pc_kill = 0;
+        FILE* fp = fopen(f, "rb");
+        if (fp) { char b[64] = {0}; if (fgets(b, sizeof b, fp)) sscanf(b, "%d %d %d %x", &s_pc_unit, &s_pc_min, &s_pc_max, &s_pc_kill); fclose(fp); }
+        if (s_pc_kill != was) fprintf(stderr, "[PIXCOUNT] left out: fp=0x%08X (frame %llu)%c", s_pc_kill, (unsigned long long)s_d3d.frame_count, 10);
+        if (s_pc_unit >= 0 && s_pc_rounds >= 40) s_pc_rounds = 0;   /* a new request after the 40 */
+    }
+    static long after = -1;   /* PIX_COUNT_AFTER=<frame>: the first frame measured (40 rounds from there) */
+    if (after < 0) { const char* e = getenv("PIX_COUNT_AFTER"); after = e ? atol(e) : 0; }
+    if (s_pc_unit < 0 || s_pc_unit > 16 || s_pc_pending || s_pc_rounds >= 40 || s_d3d.frame_count < s_pc_next ||
+        (long)s_d3d.frame_count < after) return 0;
+    if (!s_pc_ready) {
+        s_pc_ready = -1;
+        D3D12_QUERY_HEAP_DESC qd = {0}; qd.Type = D3D12_QUERY_HEAP_TYPE_OCCLUSION; qd.Count = PC_MAX;
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC bd = {0};
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = (u64)PC_MAX * 8u; bd.Height = 1;
+        bd.DepthOrArraySize = 1; bd.MipLevels = 1; bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        if (SUCCEEDED(s_d3d.device->lpVtbl->CreateQueryHeap(s_d3d.device, &qd, &IID_ID3D12QueryHeap, (void**)&s_pc_heap)) &&
+            SUCCEEDED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_pc_rb)))
+            s_pc_ready = 1;
+        fprintf(stderr, "[PIXCOUNT] %s (unit %d, %d-%d vertices)%c", s_pc_ready > 0 ? "on" : "FAILED", s_pc_unit, s_pc_min, s_pc_max, 10);
+    }
+    s_pc_active = s_pc_ready > 0;
+    return s_pc_active;
+}
+static int pc_begin(const D3D12DrawRecord* dr, u32 d)   /* the query slot, or -1 */
+{
+    if (!s_pc_active || s_pc_n >= PC_MAX || dr->is_clear || dr->is_copy ||
+        (s_pc_unit < 16 && !((dr->fb_mask >> s_pc_unit) & 1u)) ||
+        dr->vertex_count < (u32)s_pc_min || dr->vertex_count > (u32)s_pc_max) return -1;
+    const int q = s_pc_n++;
+    s_pc_info[q].fp = dr->fp_addr; s_pc_info[q].nv = dr->vertex_count; s_pc_info[q].ic = dr->index_count;
+    s_pc_info[q].d = d; s_pc_info[q].rt = dr->rt_off;
+    s_d3d.cmd_list->lpVtbl->BeginQuery(s_d3d.cmd_list, s_pc_heap, D3D12_QUERY_TYPE_OCCLUSION, (UINT)q);
+    return q;
+}
+static void pc_end(int q)
+{
+    if (q >= 0) s_d3d.cmd_list->lpVtbl->EndQuery(s_d3d.cmd_list, s_pc_heap, D3D12_QUERY_TYPE_OCCLUSION, (UINT)q);
+}
+static void pc_frame_end(void)        /* after the record loop */
+{
+    if (s_pc_pending && s_d3d.frame_count >= s_pc_frame + 8) {   /* that frame's GPU work is long done */
+        void* mp = NULL; D3D12_RANGE r = {0, (SIZE_T)s_pc_pending * 8u};
+        if (SUCCEEDED(s_pc_rb->lpVtbl->Map(s_pc_rb, 0, &r, &mp)) && mp) {
+            const u64* v = (const u64*)mp;
+            fprintf(stderr, "[PIXCOUNT] frame %llu: %d draws%c", (unsigned long long)s_pc_frame, s_pc_pending, 10);
+            for (int i = 0; i < s_pc_pending; i++)
+                fprintf(stderr, "[PIXCOUNT]  op%u fp=0x%08X verts=%u idx=%u rt=0x%08X samples=%llu%c", s_pc_info[i].d,
+                        s_pc_info[i].fp, s_pc_info[i].nv, s_pc_info[i].ic, s_pc_info[i].rt, (unsigned long long)v[i], 10);
+            D3D12_RANGE nw = {0, 0};
+            s_pc_rb->lpVtbl->Unmap(s_pc_rb, 0, &nw);
+        }
+        s_pc_pending = 0;
+    }
+    if (s_pc_active && s_pc_n > 0) {
+        s_d3d.cmd_list->lpVtbl->ResolveQueryData(s_d3d.cmd_list, s_pc_heap, D3D12_QUERY_TYPE_OCCLUSION, 0, (UINT)s_pc_n, s_pc_rb, 0);
+        s_pc_pending = s_pc_n; s_pc_frame = s_d3d.frame_count; s_pc_next = s_d3d.frame_count + 30; s_pc_rounds++;
+    }
+    s_pc_active = 0;
+}
+static void zq_frame_end(void)        /* after the record loop */
+{
+    zq_end_open();
+    zq_resolve();
+    { static int st = -1;
+      if (st < 0) { const char* e = getenv("COND_RENDER_STATS"); st = e ? atoi(e) : 0; }
+      if (st > 0 && ++s_zq_st_frames >= (u32)st) {
+          fprintf(stderr, "[COND_RENDER] per frame: %.0f queries, %.0f conditional draws, %.1f resolves (%.0f runs)%c",
+                  (double)s_zq_st_q / s_zq_st_frames, (double)s_zq_st_pred / s_zq_st_frames,
+                  (double)s_zq_st_res / s_zq_st_frames, (double)s_zq_st_runs / s_zq_st_frames, 10);
+          fprintf(stderr, "[COND_RENDER] FIFO side per frame: %.1f enables, %.0f clears, %.0f render_enable, %.0f reports (%.0f matched draws, %.0f slot refused, %.0f without a clear), %.0f records in an accumulation%c",
+                  (double)s_zq_dbg[0] / s_zq_st_frames, (double)s_zq_dbg[1] / s_zq_st_frames, (double)s_zq_dbg[2] / s_zq_st_frames,
+                  (double)s_zq_dbg[3] / s_zq_st_frames, (double)s_zq_dbg[4] / s_zq_st_frames, (double)s_zq_dbg[6] / s_zq_st_frames,
+                  (double)s_zq_dbg[7] / s_zq_st_frames, (double)s_zq_dbg[5] / s_zq_st_frames, 10);
+          memset(s_zq_dbg, 0, sizeof s_zq_dbg);
+          s_zq_st_q = s_zq_st_pred = s_zq_st_res = s_zq_st_runs = s_zq_st_frames = 0;
+      } }
+}
+
+/* MRT_MASK (patch #51, MRT_MASK=0: target 0's state on every target, as before): the colour
+ * write mask and the blend enable of the MRT targets 1..3 are their own registers on the RSX
+ * (COLOR_MASK_MRT 0x0370, BLEND_ENABLE_MRT 0x036C). Packed into the record's cmask above the
+ * target 0 nibble: D3D write mask of target t at bits [4t..4t+3], its blend enable at bit
+ * 15 + t, bit 19 = "these bits are meaningful". Only once the title has written one of the two
+ * registers: a title that never does keeps the old behaviour.
+ * MRT_MASK_LOG=1: the first distinct combinations seen on draws with more than one target. */
+static u32 rec_mrt_bits(void)
+{
+    static int on = -1, lg = -1;
+    if (on < 0) { const char* e = getenv("MRT_MASK"); on = e ? atoi(e) : 1; lg = getenv("MRT_MASK_LOG") ? 1 : 0; }
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!st) return 0;
+    if (lg && st->color_target >= 0x13) {
+        static u32 seen[48][4]; static int ns = 0; int known = 0;
+        for (int i = 0; i < ns; i++)
+            if (seen[i][0] == st->color_mask_mrt && seen[i][1] == st->blend_enable_mrt &&
+                seen[i][2] == st->color_mask && seen[i][3] == (((u32)st->blend_enable << 8) | st->color_target)) known = 1;
+        if (!known && ns < 48) {
+            seen[ns][0] = st->color_mask_mrt; seen[ns][1] = st->blend_enable_mrt; seen[ns][2] = st->color_mask;
+            seen[ns][3] = ((u32)st->blend_enable << 8) | st->color_target; ns++;
+            fprintf(stderr, "[MRT_MASK] target 0x%X: COLOR_MASK 0x%08X blend %d | COLOR_MASK_MRT 0x%04X BLEND_ENABLE_MRT 0x%X (set %d) fp 0x%08X%c",
+                    st->color_target, st->color_mask, st->blend_enable, st->color_mask_mrt, st->blend_enable_mrt,
+                    st->mrt_state_set, st->shader_program, 10);
+        }
+    }
+    /* VP_SCALE_LOG=1 (diagnostic): the guest viewport transform of each colour target, once per
+     * distinct (target, sign of the Y scale): window y = ndc y * scale + offset. This backend
+     * assumes the D3D sense (scale < 0: ndc +1 is the top row); a target drawn with scale > 0 is
+     * stored upside down in guest memory relative to ours. */
+    { static int vl = -1; if (vl < 0) vl = getenv("VP_SCALE_LOG") ? 1 : 0;
+      if (vl) { static u32 seen[64][2]; static int ns = 0; int known = 0;
+          const u32 t = st->surface_color_offset[(st->color_target == 2) ? 1 : 0];
+          const u32 sg = (st->viewport_scale[1] < 0.0f ? 1u : 0u) | (st->color_target << 4);
+          for (int i = 0; i < ns; i++) if (seen[i][0] == t && seen[i][1] == sg) known = 1;
+          if (!known && ns < 64) { seen[ns][0] = t; seen[ns][1] = sg; ns++;
+              fprintf(stderr, "[VP_SCALE] target 0x%08X (sel 0x%X) %ux%u: scale (%g, %g, %g) offset (%g, %g, %g) fp 0x%08X%c",
+                      t, st->color_target, st->surface_clip_w, st->surface_clip_h,
+                      st->viewport_scale[0], st->viewport_scale[1], st->viewport_scale[2],
+                      st->viewport_offset[0], st->viewport_offset[1], st->viewport_offset[2], st->shader_program, 10); } } }
+    if (!on || !st->mrt_state_set) return 0;
+    u32 r = 1u << 19;
+    for (u32 t = 1; t <= 3; t++) {
+        const u32 nib = (st->color_mask_mrt >> (4u * t)) & 0xFu;      /* A,R,G,B at bits 0..3 */
+        r |= (((nib & 2u) ? 1u : 0u) | ((nib & 4u) ? 2u : 0u) | ((nib & 8u) ? 4u : 0u) | ((nib & 1u) ? 8u : 0u)) << (4u * t);
+        if ((st->blend_enable_mrt >> t) & 1u) r |= 1u << (15u + t);
+    }
+    return r;
+}
+
+/* DRAW_SIG=<file> (patch #47, diagnostic): the draws the GUEST issues, before any merging or
+ * caching by this backend, to follow one object from frame to frame (scripts/drawsig_blink.py).
+ * One binary block a flip of more than 2000 draws (a race, not the menus) = 'DSIG', frame number,
+ * tick (ms), record count, then 6 u32 a draw: colour target (raw surface offset), fragment
+ * program, offset of the first enabled vertex array (+ first * stride when not indexed), offset
+ * of the first index (0 = not indexed), index / vertex count, texture 0 offset. The batches of
+ * one BEGIN/END that follow each other (DRAW_INDEX_ARRAY comes in runs of 256) make one record.
+ * First DRAW_SIG_FRAMES blocks (default 3000). Written on the FIFO thread. */
+#define DSIG_MAX 32768
+static u32   s_dsig_buf[4 + 6 * DSIG_MAX];
+static u32   s_dsig_n, s_dsig_epoch, s_dsig_end;
+static int   s_dsig_indexed;
+static FILE* s_dsig_f;
+static int   s_dsig_left;
+static int dsig_on(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char* e = getenv("DRAW_SIG"); const char* n = getenv("DRAW_SIG_FRAMES");
