+/* ---------------------------------------------------------------------------
+ * Asynchronous callbacks (local patch #72). On the console the decoder reports AUDONE / PICOUT /
+ * SEQDONE from its own thread, some time AFTER the call that caused them returned. Delivered
+ * synchronously inside cellVdecDecodeAu, MotorStorm: Apocalypse's movie player stalled for good
+ * after ~27 access units on a fast host (a slower DecodeAu, VDEC_AU_DELAY_MS=10, made it pass:
+ * the player is not ready for a callback that comes before DecodeAu returns). VDEC_CB_ASYNC=0 =
+ * synchronous as before.
+ * -----------------------------------------------------------------------*/
+#ifdef _WIN32
+typedef struct { u32 slot, gen, type; s32 data; } VdecEv;
+#define VDEC_EVQ 512
+static VdecEv s_evq[VDEC_EVQ];
+static unsigned s_ev_head, s_ev_cnt;
+static SRWLOCK s_ev_lock = SRWLOCK_INIT;
+static HANDLE s_ev_sem;
+static volatile LONG s_cb_async = -1;       /* -1 not decided, 0 synchronous, 1 helper thread */
+
+static DWORD WINAPI vdec_cb_thread(LPVOID a)
+{
+    (void)a;
+    for (;;) {
+        WaitForSingleObject(s_ev_sem, INFINITE);
+        AcquireSRWLockExclusive(&s_ev_lock);
+        if (!s_ev_cnt) { ReleaseSRWLockExclusive(&s_ev_lock); continue; }
+        VdecEv e = s_evq[s_ev_head];
+        s_ev_head = (s_ev_head + 1) % VDEC_EVQ;
+        s_ev_cnt--;
+        ReleaseSRWLockExclusive(&s_ev_lock);
+        const int live = e.slot < MAX_VDEC && s_vdec[e.slot].in_use && s_vdec_gen[e.slot] == e.gen;
+        if (live) vdec_notify(e.slot, e.type, e.data);
+    }
+}
+
+static void vdec_cb_init(void)
+{
+    if (s_cb_async >= 0) return;
+    AcquireSRWLockExclusive(&s_ev_lock);
+    if (s_cb_async < 0) {
+        const char* e = getenv("VDEC_CB_ASYNC");
+        LONG on = !(e && e[0] == '0');
+        if (on) {
+            s_ev_sem = CreateSemaphoreA(NULL, 0, VDEC_EVQ, NULL);
+            HANDLE t = s_ev_sem ? CreateThread(NULL, 0, vdec_cb_thread, NULL, 0, NULL) : NULL;
+            if (t) CloseHandle(t); else on = 0;
+        }
+        s_cb_async = on;
+    }
+    ReleaseSRWLockExclusive(&s_ev_lock);
+}
+
+static void vdec_post(u32 slot, u32 msg_type, s32 msg_data)
+{
+    vdec_cb_init();
+    if (!s_cb_async || slot >= MAX_VDEC) { vdec_notify(slot, msg_type, msg_data); return; }
+    AcquireSRWLockExclusive(&s_ev_lock);
+    if (s_ev_cnt >= VDEC_EVQ) { ReleaseSRWLockExclusive(&s_ev_lock); vdec_notify(slot, msg_type, msg_data); return; }
+    VdecEv* e = &s_evq[(s_ev_head + s_ev_cnt) % VDEC_EVQ];
+    e->slot = slot; e->gen = s_vdec_gen[slot]; e->type = msg_type; e->data = msg_data;
+    s_ev_cnt++;
+    ReleaseSRWLockExclusive(&s_ev_lock);
+    ReleaseSemaphore(s_ev_sem, 1, NULL);
+}
+#else
+static void vdec_post(u32 slot, u32 msg_type, s32 msg_data) { vdec_notify(slot, msg_type, msg_data); }
+#endif
