+static int dsig_on(void); static void dsig_flush(void);   /* DRAW_SIG, below */
+static void render_frame_dispatch(void)
+{
+    if (dsig_on()) dsig_flush();   /* the guest draws of the frame being handed over */
+    vrs_frame();
+    geo_frame();
+    if (!rsx_async_on()) { render_frame(); return; }
+    if (!s_as_thread) {
+        s_as_go   = CreateEventA(NULL, FALSE, FALSE, NULL);
+        s_as_done = CreateEventA(NULL, FALSE, FALSE, NULL);
+        s_as_thread = CreateThread(NULL, 0, as_worker, NULL, 0, NULL);
+        if (!s_as_thread) { render_frame(); return; }
+    }
+    as_wait_idle();
+    wait_for_gpu();   /* the half of the upload heaps recorded into next was drawn from by that frame */
+    /* handoff: side 1 takes the recorded frame, side 0 restarts empty on the other buffers */
+    { const int b = s_d3d.fs[0].buf;
+      s_d3d.fs[1] = s_d3d.fs[0];
+      s_d3d.fs[0].buf = b ^ 1;
+      s_d3d.fs[0].vb_offset_ = 0; s_d3d.fs[0].vp_vb_offset_ = 0; s_d3d.fs[0].vp_ib_offset_ = 0;
+      s_d3d.fs[0].draw_count_ = 0;
+      s_d3d.fs[0].vp_parity_ = s_d3d.fs[1].vp_parity_ ^ 1; }
+    s_present_side[1] = s_present_side[0];
+    s_ix_run_valid = 0;
+    ResetEvent(s_as_done);
+    InterlockedExchange(&s_as_busy, 1);
+    SetEvent(s_as_go);
