+    /* b1 layout (VP_FPCB_STRIDE): texscale[4], alphatest, fp_k[64], pad, texscale_hi[6]. */
+    if (any || strstr(hlsl, "fp_k[") || strstr(hlsl, "_rsx_b1pad[")) {
+        static const char decl0[] = "cbuffer RsxTexScale : register(b1) { float4 rsx_texscale[4]; "
+                                   "float4 _rsx_b1_atest; float4 fp_k[64]; float4 _rsx_b1pad[3]; "
+                                   "float4 rsx_texscale_hi[6]; };\n";
+        /* a program with more than 64 constants (patch #64): the wide slot */
+        static const char declx[] = "cbuffer RsxTexScale : register(b1) { float4 rsx_texscale[4]; "
+                                   "float4 _rsx_b1_atest; float4 fp_k[64]; float4 _rsx_b1pad[3]; "
+                                   "float4 rsx_texscale_hi[6]; float4 _rsx_b1pad2[2]; float4 fp_kx[192]; };\n";
+        const int wide = strstr(hlsl, "fp_kx[") != NULL;
+        const char* decl = wide ? declx : decl0;
+        const size_t dl = wide ? sizeof(declx) - 1 : sizeof(decl0) - 1, len = strlen(hlsl);
+        if (len + dl + 1 >= cap) return;
+        memmove(hlsl + dl, hlsl, len + 1);
+        memcpy(hlsl, decl, dl);
+        if (any && s_rs_on) {   /* the helper of the scaled form (patch #63), after the cbuffer */
+            static const char ts[] =
+                "float2 _rsx_ts(Texture2D t, float2 c, float2 s) {\n"
+                "    float2 d; t.GetDimensions(d.x, d.y);\n"
+                "    const float2 r = c * s;\n"
+                "    return float2(s.x < 1.0 ? min(r.x, s.x - 0.5 / d.x) : r.x,\n"
+                "                  s.y < 1.0 ? min(r.y, s.y - 0.5 / d.y) : r.y);\n"
+                "}\n";
+            const size_t sl = sizeof(ts) - 1, len2 = strlen(hlsl);
+            if (len2 + sl + 1 >= cap) return;
+            memmove(hlsl + dl + sl, hlsl + dl, len2 - dl + 1);
+            memcpy(hlsl + dl, ts, sl);
+        }
+    }
+}
