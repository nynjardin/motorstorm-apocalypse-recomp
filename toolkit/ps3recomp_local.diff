+static int rsx_async_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("RSX_ASYNC"); on = (e && e[0] == '1') ? 1 : 0;
+                  if (on) fprintf(stderr, "[D3D12] RSX_ASYNC=1: render_frame on a worker thread%c", 10); }
