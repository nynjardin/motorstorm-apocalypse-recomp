+    if (lo <= hi && hi - lo < (1u << 20)) {
+        for (int i = 0; i < 16; i++) {
+            if (vmask ? !(vmask & (1u << i)) : !s_vplan.mode[i]) continue;
+            const rsx_vertex_attrib* a = &state->vertex_attribs[i];
+            if (!a->enabled || !a->stride) continue;
+            u32 nc = a->size ? a->size : 4; if (nc > 4) nc = 4;
+            key = vrs_mix(key, ((u64)a->offset << 32) | (a->stride << 16) | (a->type << 8) | (nc << 4) | (u32)i);
+            const u64 span = (u64)(hi - lo) * a->stride + vpc_elem_bytes(a->type, nc);
+            if (s_vplan.mode[i] == 1) {
+                hvx = vrs_bytes(hvx, s_vplan.base[i] + (u64)lo * a->stride, span);
+            } else if ((a->offset & 0x80000000u) &&
+                       (a->frequency == 0 || (a->frequency == 1 && !((state->frequency_divider_op >> i) & 1u)))) {
+                const u64 o0 = (u64)(a->offset & 0x7FFFFFFFu) + (u64)lo * a->stride;
+                const u32 e0 = o0 + span <= 0x80000000ull ? cellGcmResolveLocated(0, (u32)o0) : 0;
+                if (e0 && cellGcmResolveLocated(0, (u32)(o0 + span - 1)) - e0 == (u32)(span - 1))
+                    hvx = vrs_bytes(hvx, vm_base + e0, span);
+                else unread = 1;
+            } else unread = 1;
+        }
+    } else unread = 1;
+    if (unread) s_vrs.unhashed++;
+    s_vrs.b_all++; s_vrs.i_all += count;
+    u32 slot = (u32)(key >> 20) & ((1u << VRS_BITS) - 1u);
+    VrsEnt* e = NULL;
+    for (int probe = 0; probe < 16; probe++, slot = (slot + 1) & ((1u << VRS_BITS) - 1u)) {
+        VrsEnt* c = &s_vrs.tab[slot];
+        if (c->frame == 0 || c->key == key) { e = c; break; }
+        if (c->frame + 8 < s_vrs.frame) { c->frame = 0; e = c; break; }   /* stale: take it over */
+    }
+    if (!e) { s_vrs.b_new++; s_vrs.i_new += count; return; }
+    const int same_content = !unread && e->frame && e->key == key && e->hix == hix && e->hvx == hvx;
+    if (!e->frame || e->key != key) { s_vrs.b_new++; s_vrs.i_new += count; }
+    else if (e->frame == s_vrs.frame) { s_vrs.b_same++; s_vrs.i_same += count;
+                                        if (same_content) { s_vrs.b_same_ok++; s_vrs.i_same_ok += count; } }
+    else if (e->frame + 1 == s_vrs.frame) { s_vrs.b_prev++; s_vrs.i_prev += count;
+                                            if (same_content) { s_vrs.b_prev_ok++; s_vrs.i_prev_ok += count; } }
+    else { s_vrs.b_old++; s_vrs.i_old += count; }
+    e->key = key; e->hix = hix; e->hvx = hvx; e->frame = s_vrs.frame;
+}
