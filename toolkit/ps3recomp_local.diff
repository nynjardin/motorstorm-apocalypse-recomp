+/* Channel emulation for the shadow clone: DMA GETs read main memory into the clone's LS, PUTs
+ * are dropped, tag waits complete at once; anything that talks to another agent (mailboxes,
+ * signals, events, reservations' PUTLLC, SNDSIG) aborts the comparison. op: 0 rdch, 1 wrch,
+ * 2 rchcnt. Returns 0 to abort. Reads of the decrementer return a constant and taint the run. */
+_Thread_local int g_spu_shadow_dec_taint;
+_Thread_local uint32_t g_spu_shadow_why;   /* op<<16 | ch (| cmd<<8) of the aborting channel access */
+static int spu_shadow_channel_(spu_context* ctx, int op, uint32_t ch, uint32_t v, uint32_t* out);
+int spu_shadow_channel(spu_context* ctx, int op, uint32_t ch, uint32_t v, uint32_t* out)
+{
+    int r = spu_shadow_channel_(ctx, op, ch, v, out);
+    if (!r) g_spu_shadow_why = ((uint32_t)op << 16) | (ch == MFC_Cmd ? (v & 0xFF) << 8 : 0) | ch;
+    return r;
+}
+static int spu_shadow_channel_(spu_context* ctx, int op, uint32_t ch, uint32_t v, uint32_t* out)
+{
+    extern uint8_t* vm_base;
+    if (op == 2) {                                   /* rchcnt */
+        if (ch == MFC_Cmd) { *out = 16; return 1; }
+        if (ch >= 16 && ch <= 24) { *out = 1; return 1; }
+        if (ch == SPU_RdDec || ch == SPU_WrDec || ch == MFC_RdTagMask) { *out = 1; return 1; }
+        return 0;
+    }
+    if (op == 0) {                                   /* rdch */
+        switch (ch) {
+        case MFC_RdTagStat: *out = ctx->mfc_tag_mask; return 1;
+        case MFC_RdTagMask: *out = ctx->mfc_tag_mask; return 1;
+        case SPU_RdDec:     *out = 0x7FFF0000u; g_spu_shadow_dec_taint = 1; return 1;
+        default: return 0;
+        }
+    }
+    switch (ch) {                                    /* wrch */
+    case MFC_LSA: ctx->mfc_lsa = v; return 1;
+    case MFC_EAH: ctx->mfc_eah = v; return 1;
+    case MFC_EAL: ctx->mfc_eal = v; return 1;
+    case MFC_Size: ctx->mfc_size = v; return 1;
+    case MFC_TagID: ctx->mfc_tag = v; return 1;
+    case MFC_WrTagMask: ctx->mfc_tag_mask = v; return 1;
+    case MFC_WrTagUpdate: case SPU_WrDec: case MFC_WrListStallAck: return 1;
+    case MFC_Cmd: {
+        const uint32_t cmd = v & 0xFF;
+        const uint32_t lsa = ctx->mfc_lsa & 0x3FFF0u, sz = ctx->mfc_size;
+        if (cmd >= 0xC0 && cmd <= 0xCF) return 1;            /* barrier / sync */
+        if ((cmd & 0xF0) == 0x20) return 1;                  /* PUT family: dropped */
+        if (cmd == 0x40 || cmd == 0x41 || cmd == 0x42) {     /* GET, GETB, GETF */
+            uint32_t l = ctx->mfc_lsa & 0x3FFFFu;
+            if (sz && l + sz <= 0x40000) memcpy(ctx->ls + l, vm_base + ctx->mfc_eal, sz);
+            return 1;
+        }
+        if (cmd == 0x44 || cmd == 0x45 || cmd == 0x46) {     /* GETL family: list in LS at EAL */
+            uint32_t la = ctx->mfc_eal & 0x3FFF8u, l = ctx->mfc_lsa & 0x3FFFFu;
+            for (uint32_t e = 0; e + 8 <= sz && la + e + 8 <= 0x40000; e += 8) {
+                const uint8_t* p = ctx->ls + la + e;
+                uint32_t esz = ((uint32_t)p[2] << 8 | p[3]) & 0x7FFF;
+                uint32_t eal = (uint32_t)p[4] << 24 | (uint32_t)p[5] << 16 | (uint32_t)p[6] << 8 | p[7];
+                if (esz && l + esz <= 0x40000) memcpy(ctx->ls + l, vm_base + eal, esz);
+                l = (l + esz + 15) & ~15u;
+            }
+            (void)lsa;
+            return 1;
+        }
+        if (cmd == 0xD0) {                                   /* GETLLAR: read only */
+            memcpy(ctx->ls + (ctx->mfc_lsa & 0x3FF80u), vm_base + (ctx->mfc_eal & ~127u), 128);
+            return 1;
+        }
+        return 0;                                            /* PUTLLC/PUTLLUC/SNDSIG/... */
+    }
+    default: return 0;
+    }
+}
