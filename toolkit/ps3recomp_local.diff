+static DWORD WINAPI as_worker(LPVOID p)
+{
+    (void)p;
+    t_side = 1;
+    ps3_thread_name("rsx render");   /* thread_cpu.ps1, PS3_SAMPLE_NAME="rsx render" */
+    for (;;) {
+        WaitForSingleObject(s_as_go, INFINITE);
+        render_frame();
+        InterlockedExchange(&s_as_busy, 0);
+        SetEvent(s_as_done);
+    }
+    return 0;
+}
+
+/* Wait for the frame in flight. The worker may send the window a message
+ * (Present, a resize): sent messages are served while waiting, posted ones are
+ * left for rsx_d3d12_backend_pump_messages. */
+static void as_wait_idle(void)
+{
+    while (s_as_busy) {
+        DWORD r = MsgWaitForMultipleObjects(1, &s_as_done, FALSE, 2000, QS_SENDMESSAGE);
+        if (r == WAIT_OBJECT_0 + 1) { MSG m; PeekMessageA(&m, NULL, 0, 0, PM_NOREMOVE | PM_QS_SENDMESSAGE); }
+    }
+    if (s_as_title_set) { s_as_title_set = 0; if (s_d3d.hwnd) SetWindowTextA(s_d3d.hwnd, s_as_title); }
+}
