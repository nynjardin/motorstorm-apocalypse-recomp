+/* Depth-comparison (shadow) units of the draw about to get a pipeline:
+ * fp_shadow_prepare() fills these before each vp_get_fp_pso call; the key
+ * folds into the pipeline's ucode hash. */
+static rsx_fp_shadow_desc s_fp_shadow[16];
+static u32 s_fp_shadow_key;
+/* MotorStorm local patch #26 (sRGB). Texture gamma: TEXTURE_ADDRESS bits 20-23
+ * ask for sRGB -> linear on the sampled colour (this title: nearly every colour
+ * texture and several render targets). fp_shadow_prepare() fills the masks of
+ * the draw's bound units; vp_get_fp_pso keeps those the program samples, folds
+ * them into the pipeline key and hands them to the decompiler. SRGB_TEX=0 = off.
+ * sRGB write: SET_SHADER_PACKER (0x1FEC) nonzero = linear -> sRGB on integer
+ * colour targets; carried per draw as FP_CTRL_SRGB_OUT in fp_ctrl (part of the
+ * key). SRGB_OUT=0 = off. */
+static u8  s_fp_gamma[16];
+#define FP_CTRL_SRGB_OUT 0x80000000u
+/* TC2D=1 (patch #53, off by default: not validated): bit 16 + i of a record's fp_ctrl = texture coordinate i is
+ * declared 2D (SET_TEX_COORD_CONTROL bit 0). The program then reads it as (x, y, 0, 1/w): its
+ * z and w as the vertex program left them are not used. MotorStorm: Apocalypse's tyre-trail
+ * material projects (TXP-style divide by w) such a coordinate to read the scene behind it; with
+ * the stray w (negative) the read landed at the point-mirrored pixel and the trail showed the
+ * other end of the screen: the "mirror" strips behind the vehicles. Part of the pipeline key
+ * through fp_ctrl; applied to the translated HLSL by fp_apply_tc2d. TC2D_LOG=1: programs and
+ * masks. */
+#define FP_CTRL_TC2D_SHIFT 16
+#define FP_CTRL_TC2D_MASK  (0x3FFu << FP_CTRL_TC2D_SHIFT)
+static void fp_apply_tc2d(char* hlsl, size_t cap, u32 mask)
+{
+    static char out[RSX_FP_HLSL_BUFFER_SIZE];
+    if (!mask) return;
+    const char* body = strstr(hlsl, " main(");          /* the declarations before it stay as they are */
+    if (!body) return;
+    size_t o = (size_t)(body - hlsl);
+    if (o >= sizeof out) return;
+    memcpy(out, hlsl, o);
+    const char* p = body;
+    while (*p) {
+        int n = -1;
+        if (!strncmp(p, "(input.tc", 9) && p[9] >= '0' && p[9] <= '9' && ((mask >> (p[9] - '0')) & 1u) &&
+            !strncmp(p + 10, " * _rsx_inv_w(input.position))", 30)) {
+            n = snprintf(out + o, sizeof out - o,
+                         "float4((input.tc%c * _rsx_inv_w(input.position)).xy, 0.0, (1.0 / input.position.w))", p[9]);
+            p += 40;
+        } else if (!strncmp(p, "input.tc", 8) && p[8] >= '0' && p[8] <= '9' && !(p[9] >= '0' && p[9] <= '9') &&
+                   ((mask >> (p[8] - '0')) & 1u)) {
+            n = snprintf(out + o, sizeof out - o, "float4(input.tc%c.xy, 0.0, (1.0 / input.position.w))", p[8]);
+            p += 9;
+        }
+        if (n >= 0) { if (o + (size_t)n >= sizeof out - 1) return; o += (size_t)n; }
+        else { if (o >= sizeof out - 1) return; out[o++] = *p++; }
+    }
+    out[o] = 0;
+    if (o + 1 <= cap) memcpy(hlsl, out, o + 1);
+}
+static int srgb_tex_on(void)
+{ static int v = -1; if (v < 0) { const char* e = getenv("SRGB_TEX"); v = !(e && e[0] == '0'); } return v; }
+/* TEX_FMT9B=0: W32_Z32_Y32_X32_FLOAT textures are not recorded, as before patch #56. */
+static int tex_fmt9b_on(void)
+{ static int v = -1; if (v < 0) { const char* e = getenv("TEX_FMT9B"); v = !(e && e[0] == '0'); } return v; }
+static int srgb_out_on(void)
+{ static int v = -1; if (v < 0) { const char* e = getenv("SRGB_OUT"); v = !(e && e[0] == '0'); } return v; }
+/* Units a program samples, by code hash (walking the ucode per draw is too slow). */
+static u32 fp_units_cached(u32 code_hash, const u8* ucode)
+{
+    static struct { u32 hash, units; u8 set; } s_fu[1024];
+    const u32 i = (code_hash ^ (code_hash >> 11)) & 1023u;
+    if (s_fu[i].set && s_fu[i].hash == code_hash) return s_fu[i].units;
+    s_fu[i].hash = code_hash; s_fu[i].units = rsx_fp_texture_units(ucode, fp_ucode_max()); s_fu[i].set = 1;
+    return s_fu[i].units;
+}
+/* Compact vertex mask of the draw whose pipeline vp_get_fp_pso is asked for
+ * (D3D12DrawRecord.vmask): set by the caller around the call, like
+ * s_fp_shadow_key. It selects the input layout, so it is part of the key. */
+static u32 s_fp_vmask;
+static u32 vp_mask_count(u32 m);   /* compact vertex stride / 16 (defined with read_vp_vertex_compact) */
+static int shadow_cmp_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("SHADOW_CMP"); on = e ? atoi(e) : 1; }
+    return on;
+}
+
+/* Hash index of vp_fp[] (entry index + 1, 0 = empty; linear probing). */
+#define FPIX_N 16384
+static int s_fpix[FPIX_N];
+static u32 fp_key_hash(u32 uhash, u32 vs_hash, int vs_idx, u32 gen, u32 blend, int nrt, u32 rtfmt,
+                       u32 ctrl, u32 cmask, u32 cull, u32 cube_mask, u32 unnorm_mask, u64 zs)
+{
+    u32 v[14] = { uhash, vs_hash, (u32)vs_idx, gen, blend, (u32)nrt, rtfmt, ctrl, cmask, cull,
+                  cube_mask, unnorm_mask, (u32)zs, (u32)(zs >> 32) };
+    u32 h = 2166136261u;
+    for (int i = 0; i < 14; i++) { h ^= v[i]; h *= 16777619u; h ^= h >> 15; }
+    return h;
+}
+static void fpix_insert(u32 key, int idx)
+{
+    for (u32 p = 0; p < FPIX_N; p++) {
+        int* s = &s_fpix[(key + p) & (FPIX_N - 1)];
+        if (!*s) { *s = idx + 1; return; }
+    }
+}
+
+/* RSX_CAP: <frame dir>/fps.hlsl = every distinct fragment program of the captured frame,
+ * decompiled as it is in guest memory at that moment, constants inline (not hoisted), with the
+ * ops that use it. fp_dump.hlsl (FP_DUMP) is indexed by program address and addresses are
+ * reused between scenes: the first program seen at an address is rarely the frame's. */
+static void cap_dump_fps(const char* dir, u32 ndraws)
+{
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    static char hl[RSX_FP_HLSL_BUFFER_SIZE];
+    static u32 seen[1024]; int ns = 0;
+    char path[512]; snprintf(path, sizeof path, "%s/fps.hlsl", dir);
+    FILE* f = fopen(path, "w");
+    if (!f || !vm_base) { if (f) fclose(f); return; }
+    rsx_fp_set_hoist_constants(0);
+    for (u32 d = 0; d < ndraws && d < MAX_DRAWS; d++) {
+        const D3D12DrawRecord* r = &s_d3d.draws[d];
+        if (r->is_copy || r->is_clear || !r->fp_addr) continue;
+        int known = 0;
+        for (int i = 0; i < ns; i++) if (seen[i] == r->fp_addr) { known = 1; break; }
+        if (known || ns >= 1024) continue;
+        seen[ns++] = r->fp_addr;
+        u32 off = cellGcmResolveLocated((r->fp_addr & 0x3u) == 1, r->fp_addr & ~0x3u);
+        if (off == 0xFFFFFFFFu) continue;
+        fprintf(f, "/* ===== fp=0x%08X (guest 0x%08X) ctrl=0x%X; ops:", r->fp_addr, off, r->fp_ctrl);
+        int shown = 0;
+        for (u32 e = d; e < ndraws && e < MAX_DRAWS; e++) {
+            const D3D12DrawRecord* q = &s_d3d.draws[e];
+            if (q->is_copy || q->is_clear || q->fp_addr != r->fp_addr) continue;
+            if (shown++ < 24) fprintf(f, " %u", e);
+        }
+        fprintf(f, " (%d draws) rt=0x%08X ===== */\n", shown, r->rt_off);
+        hl[0] = 0;
+        int n = rsx_fp_decompile(vm_base + off, fp_ucode_max(), r->fp_ctrl & ~(FP_CTRL_SRGB_OUT | FP_CTRL_TC2D_MASK), hl, sizeof hl);
+        if (n > 0 && (r->fp_ctrl & FP_CTRL_TC2D_MASK)) {
+            fprintf(f, "/* 2D texture coordinates (TC2D): mask 0x%03X */\n", (r->fp_ctrl & FP_CTRL_TC2D_MASK) >> FP_CTRL_TC2D_SHIFT);
+            fp_apply_tc2d(hl, sizeof hl, (r->fp_ctrl & FP_CTRL_TC2D_MASK) >> FP_CTRL_TC2D_SHIFT);
+        }
+        if (n > 0) fprintf(f, "%s\n", hl); else fprintf(f, "/* decompile failed */\n");
+    }
+    rsx_fp_set_hoist_constants(1);
+    fclose(f);
+}
+
+/* ---- Pipeline warm-up (RSX_PSO_WARM, default 1; needs RSX_SHADER_CACHE) ----------------
+ * A guest pipeline is created the first time a draw needs it: decompile, shader lookup,
+ * CreateGraphicsPipelineState, ~1.5 ms each on the render thread. A race start or a piece of
+ * scenery coming to life asks for 30-55 new ones in a single frame: the image froze for
+ * 100-300 ms (RSX_HITCH). Each pipeline created is now written down as a "recipe" (the keys of
+ * its two cached shaders + the whole state description) in <RSX_SHADER_CACHE>/pso_recipes.bin,
+ * and at the next launch a background thread creates them all again before the title needs
+ * them; the miss path then finds its pipeline ready, by the hash of the same recipe.
+ * The recipe is built from the final D3D12 description, not from the guest key, so nothing
+ * the description depends on can be forgotten: a changed decompiler gives new shader keys and
+ * new recipes, the old ones only cost warm-up time. RSX_PSO_WARM=0 = create on demand only. */
+typedef struct {
+    u32 magic, dbt;
+    unsigned long long vs_key, ps_key;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;              /* every pointer zeroed */
+    struct { u32 idx, fmt, slot, off, cls, step; } il[16];
+} PsoRecipe;
+#define PSO_RECIPE_MAGIC 0x50534F31u   /* "PSO1" */
+#define PSOW_N 32768
+static struct { unsigned long long h; ID3D12PipelineState* pso; int rec; } s_psow[PSOW_N];
+static PsoRecipe* s_psow_rec; static int s_psow_nrec, s_psow_cap;
+static CRITICAL_SECTION s_psow_lock; static int s_psow_state;   /* 0 = not started, 1 = on, -1 = off */
+static FILE* s_psow_file;
+static int s_pso_warm_hits; static double s_pso_create_t;
+
+static unsigned long long sc_key_of_blob(ID3DBlob* b)
+{
+    unsigned long long k = 0;
+    if (!b || !s_sc_lock_init) return 0;
+    EnterCriticalSection(&s_sc_lock);
+    for (unsigned j = 0; j < SC_N; j++) if (s_sc[j].blob == b) { k = s_sc[j].key; break; }
+    LeaveCriticalSection(&s_sc_lock);
+    return k;
+}
+static ID3DBlob* sc_blob_of_key(unsigned long long key)
+{
+    ID3DBlob* b = NULL;
+    const unsigned idx = (unsigned)(key ^ (key >> 29)) & (SC_N - 1);
+    EnterCriticalSection(&s_sc_lock);
+    for (unsigned q = 0; q < 32; q++) {
+        unsigned j = (idx + q) & (SC_N - 1);
+        if (s_sc[j].key == key && s_sc[j].blob) { b = s_sc[j].blob; b->lpVtbl->AddRef(b); break; }
+        if (!s_sc[j].key) break;
+    }
+    LeaveCriticalSection(&s_sc_lock);
+    return b;
+}
+static unsigned long long psow_hash(const PsoRecipe* r)
+{
+    unsigned long long h = 1469598103934665603ull;
+    const u8* q = (const u8*)r;
+    for (size_t i = 0; i < sizeof *r; i++) { h ^= q[i]; h *= 1099511628211ull; }
+    return h ? h : 1;
+}
+/* Slot of hash h (existing, or the free one where it goes); -1 = table full. Lock held. */
+static int psow_slot(unsigned long long h)
+{
+    for (unsigned q = 0; q < 64; q++) {
+        unsigned j = ((unsigned)(h ^ (h >> 31)) + q) & (PSOW_N - 1);
+        if (s_psow[j].h == h || !s_psow[j].h) return (int)j;
+    }
+    return -1;
+}
+static int psow_fill(PsoRecipe* r, const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd,
+                     const D3D12_INPUT_ELEMENT_DESC* il, ID3DBlob* vsb, ID3DBlob* psb, int dbt)
+{
+    if (s_psow_state != 1) return 0;
+    memset(r, 0, sizeof *r);
+    r->magic = PSO_RECIPE_MAGIC; r->dbt = dbt ? 1u : 0u;
+    r->vs_key = sc_key_of_blob(vsb); r->ps_key = sc_key_of_blob(psb);
+    if (!r->vs_key || !r->ps_key || pd->InputLayout.NumElements != 16) return 0;
+    r->pd = *pd;
+    r->pd.pRootSignature = NULL; r->pd.VS.pShaderBytecode = NULL; r->pd.PS.pShaderBytecode = NULL;
+    r->pd.InputLayout.pInputElementDescs = NULL;
+    for (int i = 0; i < 16; i++) {
+        r->il[i].idx = il[i].SemanticIndex; r->il[i].fmt = (u32)il[i].Format;
+        r->il[i].slot = il[i].InputSlot; r->il[i].off = il[i].AlignedByteOffset;
+        r->il[i].cls = (u32)il[i].InputSlotClass; r->il[i].step = il[i].InstanceDataStepRate;
+    }
+    return 1;
+}
+static HRESULT create_pso_depth_bounds(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd, ID3D12PipelineState** out);
+static DWORD WINAPI psow_thread(LPVOID arg)
+{
+    (void)arg;
+    double t0 = perf_now(); int made = 0, skipped = 0, failed = 0;
+    /* The shader blobs come from the disk-cache preload: let it finish (it takes well under a
+     * second; 20 s at most on a cold disk). */
+    for (int w = 0; w < 200 && !s_sc_preload_done; w++) Sleep(100);
+    for (int i = 0; ; i++) {
+        PsoRecipe r; unsigned long long h;
+        EnterCriticalSection(&s_psow_lock);
+        if (i >= s_psow_nrec) { LeaveCriticalSection(&s_psow_lock); break; }
+        r = s_psow_rec[i]; h = psow_hash(&r);
+        int j = psow_slot(h);
+        int have = j >= 0 && s_psow[j].h == h && s_psow[j].pso;
+        LeaveCriticalSection(&s_psow_lock);
+        if (have || j < 0) { skipped++; continue; }
+        ID3DBlob* vb = sc_blob_of_key(r.vs_key); ID3DBlob* pb = sc_blob_of_key(r.ps_key);
+        if (!vb || !pb || vb->lpVtbl->GetBufferSize(vb) != r.pd.VS.BytecodeLength ||
+            pb->lpVtbl->GetBufferSize(pb) != r.pd.PS.BytecodeLength) {
+            if (vb) vb->lpVtbl->Release(vb);
+            if (pb) pb->lpVtbl->Release(pb);
+            skipped++; continue;                       /* shaders of an older decompiler */
+        }
+        D3D12_INPUT_ELEMENT_DESC il[16];
+        for (int k = 0; k < 16; k++) {
+            il[k].SemanticName = "ATTR"; il[k].SemanticIndex = r.il[k].idx;
+            il[k].Format = (DXGI_FORMAT)r.il[k].fmt; il[k].InputSlot = r.il[k].slot;
+            il[k].AlignedByteOffset = r.il[k].off;
+            il[k].InputSlotClass = (D3D12_INPUT_CLASSIFICATION)r.il[k].cls;
+            il[k].InstanceDataStepRate = r.il[k].step;
+        }
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = r.pd;
+        pd.pRootSignature = s_d3d.vp_root_sig;
+        pd.VS.pShaderBytecode = vb->lpVtbl->GetBufferPointer(vb);
+        pd.PS.pShaderBytecode = pb->lpVtbl->GetBufferPointer(pb);
+        pd.InputLayout.pInputElementDescs = il;
+        ID3D12PipelineState* pso = NULL;
+        HRESULT hr = r.dbt ? create_pso_depth_bounds(&pd, &pso)
+                           : s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                                 s_d3d.device, &pd, &IID_ID3D12PipelineState, (void**)&pso);
+        vb->lpVtbl->Release(vb); pb->lpVtbl->Release(pb);
+        if (FAILED(hr) || !pso) { failed++; continue; }
+        EnterCriticalSection(&s_psow_lock);
+        j = psow_slot(h);
+        if (j >= 0 && s_psow[j].h == h && !s_psow[j].pso) { s_psow[j].pso = pso; pso = NULL; made++; }
+        LeaveCriticalSection(&s_psow_lock);
+        if (pso) pso->lpVtbl->Release(pso);            /* the render thread made it meanwhile */
+    }
+    fprintf(stderr, "[pso-warm] %d pipelines ready in %.2f s (%d skipped, %d failed)%c",
+            made, perf_now() - t0, skipped, failed, 10);
+    return 0;
+}
+static void psow_init(void)
+{
+    const char* e = getenv("RSX_PSO_WARM"); const char* dir = getenv("RSX_SHADER_CACHE");
+    s_psow_state = -1;
+    if ((e && e[0] == '0') || !dir || !*dir || getenv("RSX_SHADER_CACHE_OFF")) return;
+    InitializeCriticalSection(&s_psow_lock);
+    char path[700]; snprintf(path, sizeof path, "%s/pso_recipes.bin", dir);
+    FILE* f = fopen(path, "rb");
+    if (f) {
+        PsoRecipe r; long good = 0;
+        while (fread(&r, sizeof r, 1, f) == 1) {
+            if (r.magic != PSO_RECIPE_MAGIC) break;      /* another layout: start over */
+            good = ftell(f);
+            unsigned long long h = psow_hash(&r);
+            int j = psow_slot(h);
+            if (j < 0 || s_psow[j].h == h) continue;
+            if (s_psow_nrec >= s_psow_cap) {
+                int nc = s_psow_cap ? s_psow_cap * 2 : 1024;
+                PsoRecipe* nr = (PsoRecipe*)realloc(s_psow_rec, (size_t)nc * sizeof *nr);
+                if (!nr) break;
+                s_psow_rec = nr; s_psow_cap = nc;
+            }
+            s_psow_rec[s_psow_nrec] = r;
+            s_psow[j].h = h; s_psow[j].rec = s_psow_nrec++;
+        }
+        long end = (fseek(f, 0, SEEK_END), ftell(f));
+        fclose(f);
+        if (good != end) {                               /* torn tail or foreign file: rewrite the good part */
+            f = fopen(path, "wb");
+            if (f) { if (s_psow_nrec) fwrite(s_psow_rec, sizeof(PsoRecipe), (size_t)s_psow_nrec, f); fclose(f); }
+        }
+    }
+    s_psow_file = fopen(path, "ab");
+    s_psow_state = 1;
+    fprintf(stderr, "[pso-warm] %d recipes in %s%c", s_psow_nrec, path, 10);
+    if (s_psow_nrec) {
+        HANDLE th = CreateThread(NULL, 0, psow_thread, NULL, 0, NULL);
+        if (th) { SetThreadPriority(th, THREAD_PRIORITY_BELOW_NORMAL); CloseHandle(th); }
+    }
+}
+/* The warmed pipeline of this recipe (a new reference), or NULL. */
+static ID3D12PipelineState* psow_take(const PsoRecipe* r)
+{
+    ID3D12PipelineState* pso = NULL;
+    const unsigned long long h = psow_hash(r);
+    EnterCriticalSection(&s_psow_lock);
+    int j = psow_slot(h);
+    if (j >= 0 && s_psow[j].h == h && s_psow[j].pso) { pso = s_psow[j].pso; pso->lpVtbl->AddRef(pso); }
+    LeaveCriticalSection(&s_psow_lock);
+    return pso;
+}
+/* A pipeline the render thread had to create itself: keep it for the rest of this run and,
+ * when the recipe is new, write it down for the next ones. */
+static void psow_add(const PsoRecipe* r, ID3D12PipelineState* pso)
+{
+    const unsigned long long h = psow_hash(r);
+    EnterCriticalSection(&s_psow_lock);
+    int j = psow_slot(h);
+    if (j >= 0) {
+        if (!s_psow[j].h) {
+            s_psow[j].h = h; s_psow[j].rec = -1;
+            if (s_psow_file) { fwrite(r, sizeof *r, 1, s_psow_file); fflush(s_psow_file); }
+        }
+        if (!s_psow[j].pso) { s_psow[j].pso = pso; pso->lpVtbl->AddRef(pso); }
+    }
+    LeaveCriticalSection(&s_psow_lock);
+}
+
 static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, int nrt,
