+/* ---------------------------------------------------------------------------
+ * RSX_ASYNC=1: render_frame() on a worker thread.
+ *
+ * A race frame of MotorStorm Apocalypse spends ~30 ms in render_frame (texture
+ * checks + SRVs ~15 ms, command recording ~7 ms) on the thread that walks the
+ * FIFO, at every flip; the guest's main thread waits on an RSX label behind it.
+ * With RSX_ASYNC the flip only hands the recorded frame over (side 0 -> side 1,
+ * see t_side) and the FIFO thread goes on with the next frame's commands.
+ * At most one frame is in flight: the next handoff waits for the worker, and
+ * for the GPU, before the recording side reuses the upload-heap half the frame
+ * before last was drawn from.
+ * What changes for the guest: textures and fragment-program code are read from
+ * guest memory up to one render_frame later than the flip (they were already
+ * read at the flip, not at the draw); RT_WB write-backs land from the worker.
+ * -----------------------------------------------------------------------*/
+/* VTX_REUSE_STATS=<n> (MotorStorm local patch #42, diagnostic): how much of a frame's indexed
+ * geometry was already converted -- earlier in the same frame (multi-pass: shadows, depth, main)
+ * or in the previous frame (static world) -- and whether its source bytes (indices and the
+ * vertex arrays they reach) were identical. Every indexed batch is keyed by where its indices
+ * and vertex arrays are and how they are laid out; the content is hashed (this is what makes
+ * the diagnostic expensive: read the shares, not the FPS). One line every <n> frames:
+ *   batches, indices; share repeated in the same frame / of which identical content;
+ *   share seen in the previous frame / of which identical content; first sightings. */
+typedef struct { u64 key, hix, hvx; u32 frame, pad; } VrsEnt;
+#define VRS_BITS 17
+static struct {
+    int on;                       /* -1 unread, 0 off, n = report period in frames */
+    VrsEnt* tab;
+    u32 frame, nframes;
+    u64 b_all, b_same, b_same_ok, b_prev, b_prev_ok, b_new, b_old;
+    u64 i_all, i_same, i_same_ok, i_prev, i_prev_ok, i_new, i_old;
+    u64 unhashed;                 /* batches with an attribute the diagnostic could not read */
+} s_vrs = { -1 };
+static int vrs_on(void)
+{
+    if (s_vrs.on < 0) {
+        const char* e = getenv("VTX_REUSE_STATS");
+        s_vrs.on = e ? atoi(e) : 0;
+        if (s_vrs.on < 0) s_vrs.on = 0;
+        if (s_vrs.on) {
+            s_vrs.tab = (VrsEnt*)calloc((size_t)1 << VRS_BITS, sizeof(VrsEnt));
+            if (!s_vrs.tab) s_vrs.on = 0;
+            s_vrs.frame = 2;
+        }
+    }
+    return s_vrs.on;
+}
+static void vrs_frame(void)
+{
+    if (!vrs_on()) return;
+    s_vrs.frame++;
+    if (++s_vrs.nframes < (u32)s_vrs.on) return;
+    const double f = (double)s_vrs.nframes, ia = s_vrs.i_all ? (double)s_vrs.i_all : 1.0;
+    fprintf(stderr, "[vtx-reuse] per frame: %.0f batches, %.0fk indices | same frame %.1f%% (identical %.1f%%)"
+                    " | previous frame %.1f%% (identical %.1f%%) | older %.1f%% | new %.1f%% | batches: same %.0f (%.0f ok)"
+                    " prev %.0f (%.0f ok) new %.0f | unreadable %.0f%c",
+            (double)s_vrs.b_all / f, (double)s_vrs.i_all / f / 1000.0,
+            100.0 * (double)s_vrs.i_same / ia, 100.0 * (double)s_vrs.i_same_ok / ia,
+            100.0 * (double)s_vrs.i_prev / ia, 100.0 * (double)s_vrs.i_prev_ok / ia,
+            100.0 * (double)s_vrs.i_old / ia, 100.0 * (double)s_vrs.i_new / ia,
+            (double)s_vrs.b_same / f, (double)s_vrs.b_same_ok / f, (double)s_vrs.b_prev / f,
+            (double)s_vrs.b_prev_ok / f, (double)s_vrs.b_new / f, (double)s_vrs.unhashed / f, 10);
+    s_vrs.nframes = 0;
+    s_vrs.b_all = s_vrs.b_same = s_vrs.b_same_ok = s_vrs.b_prev = s_vrs.b_prev_ok = s_vrs.b_new = s_vrs.b_old = 0;
+    s_vrs.i_all = s_vrs.i_same = s_vrs.i_same_ok = s_vrs.i_prev = s_vrs.i_prev_ok = s_vrs.i_new = s_vrs.i_old = 0;
+    s_vrs.unhashed = 0;
+}
