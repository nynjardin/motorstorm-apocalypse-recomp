+        if (!key || !end || *end != '_' || fd.nFileSizeHigh || !fd.nFileSizeLow) continue;
+        const unsigned idx = (unsigned)(key ^ (key >> 29)) & (SC_N - 1);
+        int have = 0;
+        EnterCriticalSection(&s_sc_lock);
+        for (unsigned q = 0; q < 32; q++) {
+            unsigned j = (idx + q) & (SC_N - 1);
+            if (s_sc[j].key == key) { have = 1; break; }
+            if (!s_sc[j].key) break;
