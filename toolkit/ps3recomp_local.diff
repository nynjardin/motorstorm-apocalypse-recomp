+    if (s_geo.stats > 0 && ++s_geo.st_frames >= (u32)s_geo.stats) {
+        const double f = (double)s_geo.st_frames;
+        fprintf(stderr, "[geo] per frame: %.0f hits, %.0f builds, %.0f changed, %.0f replayed, %.0f unreadable,"
